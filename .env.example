# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=
POSTGRES_DB=artex

# 默认启动内置 ZAP；设为 false 可关闭 ZAP。
ARTEX_ZAP_ENABLED=true
ARTEX_BUNDLED_MCP_DEFAULTS=true

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
